<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    android:fillViewport="true">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="251dp"
            android:layout_height="56dp"
            android:text="SMART PANTRY"
            android:textColor="#28734A"
            android:textSize="30sp"
            android:textStyle="bold"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Good food. Less waste."
            android:textColor="#203629"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cook delicious meals using what you already have. Store and manage your food reserves."
            android:textColor="#68766B"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY PANTRY"
                android:textColor="#68766B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtIngredientCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 ingredients"
                android:textColor="#203629"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Keeps track of the food in your kitchen."
                android:textColor="#68766B"
                android:textSize="14sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnMyPantry"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#28734A"
            android:text="My Pantry"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAddIngredient"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text=" +  Add Ingredient"
            android:textColor="#FFFFFF"
            android:backgroundTint="#28734A"/>

        <Button
            android:id="@+id/btnSuggestedRecipes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Suggested Recipes"
            android:textColor="#FFFFFF"
            android:backgroundTint="#28734A"/>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:backgroundTint="#28734A"/>



    </LinearLayout>
</ScrollView>
