<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7F2">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#245C3A"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtPantryCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your ingredients"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:textColor="#203629"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnAddPantryItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add Ingredient" />

    <ListView
        android:id="@+id/listPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="8dp"
        android:paddingTop="12dp" />

</LinearLayout>
