<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#24382B"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your Smart Pantry Manager app."
            android:textSize="16sp"
            android:textColor="#526257"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Application Information"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#24382B" />

        <TextView
            android:id="@+id/txtAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager"
            android:textSize="16sp"
            android:textColor="#526257"
            android:paddingTop="12dp"
            android:paddingBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D9E1D8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data Management"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#24382B"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remove every ingredient from your pantry. Your recipe collection will remain saved."
            android:textSize="15sp"
            android:textColor="#526257"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnClearPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear All Pantry Ingredients"
            android:backgroundTint="#B3261E"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
